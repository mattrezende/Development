# String de conexão do MongoDB (Atlas ou outro). Ex.:
# mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/bosque?retryWrites=true&w=majority
MONGODB_URI=

# Segredo usado para assinar os JWTs de sessão do admin. Gere algo aleatório e longo.
JWT_SECRET=

# Porta em que a API sobe
PORT=8090

# Origem(ns) permitidas para CORS (frontend). Separe múltiplas por vírgula.
CORS_ORIGIN=http://localhost:3000

# URL pública em que esta API é servida (usada para montar URLs completas de imagens
# quando o frontend está em outro domínio). Deixe vazio para usar caminhos relativos.
PUBLIC_API_URL=

# Usados apenas pelo script `npm run create-admin` para criar a primeira conta do painel
ADMIN_EMAIL=
ADMIN_PASSWORD=
