NODE_ENV=development
PORT=3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/exelion?retryWrites=true&w=majority

# Secret used to sign session JWTs — generate a long random value, e.g. `openssl rand -hex 64`
JWT_SECRET=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# URLs
WEBHOOK_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
